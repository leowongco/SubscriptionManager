# 複製為 .env 並填入實際值，docker-compose.yml 會自動讀取這個檔案。

# 對外綁定的 IP 與 port（跟 1Panel App Store 範本用同一組變數名稱，
# 用 1Panel 的「Compose 專案」開啟時，面板的連接埠選擇器可以直接接管這兩個值；
# 純手動 docker compose 部署則直接改這裡的預設值即可）。
# 容器內部固定監聽 3000，只有對外映射的這段可調，VPS 上 3000 被其他服務佔用時改 PANEL_APP_PORT_HTTP 就好。
HOST_IP=0.0.0.0
PANEL_APP_PORT_HTTP=3000

# 整站登入帳密（Basic Auth）。強烈建議在正式環境設定 APP_PASSWORD，
# 沒設定的話 API 與網頁完全不需要密碼就能被連得到主機的任何人存取。
APP_USERNAME=admin
APP_PASSWORD=

# Telegram 低餘額通知（選填，不設定則不發送通知）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 手動觸發 /api/sync 端點時的驗證密鑰（選填，強烈建議設定）
# 每日自動扣款是容器內建的 node-cron 排程，不需要這個密鑰；
# 這個密鑰只用來保護「手動用 curl 觸發一次 /api/sync」這個備用端點。
SYNC_SECRET=

# 自動扣款的 cron 排程（預設每天 UTC 00:10）
SYNC_CRON_SCHEDULE=10 0 * * *

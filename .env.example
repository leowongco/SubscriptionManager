# 複製為 .env 並填入實際值，docker-compose.yml 會自動讀取這個檔案。

# 對外綁定的 IP 與 port（跟 1Panel App Store 範本用同一組變數名稱，
# 用 1Panel 的「Compose 專案」開啟時，面板的連接埠選擇器可以直接接管這兩個值；
# 純手動 docker compose 部署則直接改這裡的預設值即可）。
# 容器內部固定監聽 3000，只有對外映射的這段可調。預設故意不用 3000，
# 因為那是很多面板/服務的常用 port，容易撞；這裡改成一個較少見的 port，
# 若在你的 VPS 上還是撞到，直接改成任何沒被佔用的號碼即可。
HOST_IP=0.0.0.0
PANEL_APP_PORT_HTTP=28174

# 整站登入帳密（Basic Auth）。強烈建議在正式環境設定 APP_PASSWORD，
# 沒設定的話 API 與網頁完全不需要密碼就能被連得到主機的任何人存取。
APP_USERNAME=admin
APP_PASSWORD=

# Telegram（選填，不設定則低餘額通知/繳費提醒/bot 綁定都不會啟用）
# TELEGRAM_BOT_TOKEN：跟 @BotFather 申請一個 bot 拿到的 token，同一個 bot 同時用於：
#   - 低餘額通知（發到 TELEGRAM_CHAT_ID 這個群組/頻道）
#   - 繳費提醒 bot（長輪詢接收訊息，私訊未繳費且已綁定的成員，見「Apple ID 管理」/
#     「訂閱關係對應」頁面裡成員旁邊的 Telegram 圖示按鈕產生綁定連結）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 繳費提醒排程（cron 語法，容器內時區固定 UTC），預設每天 UTC 01:00
TELEGRAM_REMINDER_CRON_SCHEDULE=0 1 * * *
# 同一筆未繳款項，兩次提醒之間至少間隔幾天（避免每天洗版式重複提醒）
TELEGRAM_REMINDER_INTERVAL_DAYS=3

# 手動觸發 /api/sync 端點時的驗證密鑰（選填，強烈建議設定）
# 每日自動扣款是容器內建的 node-cron 排程，不需要這個密鑰；
# 這個密鑰只用來保護「手動用 curl 觸發一次 /api/sync」這個備用端點。
SYNC_SECRET=

# 自動扣款的 cron 排程（預設每天 UTC 00:10）
SYNC_CRON_SCHEDULE=10 0 * * *
